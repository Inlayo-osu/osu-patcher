<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk" DefaultTargets="Build">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <ApplicationIcon>icon.ico</ApplicationIcon>
        <ApplicationVersion>1.0.0</ApplicationVersion>
        <AssemblyName>Inlayo-patcher</AssemblyName>
        <RootNamespace>Osu.Patcher.Injector</RootNamespace>
        <TargetFramework>net8.0-windows</TargetFramework>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <NoWarn>$(NoWarn);NU1702</NoWarn> <!-- ProjectReferences used here are expected to not match target framework -->
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
    </PropertyGroup>
    <PropertyGroup>
        <HookOutputDirectory>$(MSBuildProjectDirectory)\..\Osu.Patcher.Hook\bin\$(Configuration)\net452\</HookOutputDirectory>
    </PropertyGroup>
    <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
        <HookOutputDirectory>$(HookOutputDirectory)$(RuntimeIdentifier)\</HookOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="HoLLy.ManagedInjector" Version="1.0.0"/>
        <ProjectReference Include="../Osu.Patcher.Hook/Osu.Patcher.Hook.csproj">
            <SetTargetFramework>TargetFramework=net452</SetTargetFramework>
        </ProjectReference>
        <EmbeddedResource Include="$(HookOutputDirectory)osu!.hook.dll" LogicalName="InjectionFiles.osu!.hook.dll"/>
        <EmbeddedResource Include="$(HookOutputDirectory)osu!.stubs.dll" LogicalName="InjectionFiles.osu!.stubs.dll"/>
        <EmbeddedResource Include="$(HookOutputDirectory)utils.dll" LogicalName="InjectionFiles.utils.dll"/>
        <EmbeddedResource Include="$(HookOutputDirectory)0Harmony.dll" LogicalName="InjectionFiles.0Harmony.dll"/>
        <EmbeddedResource Include="$(HookOutputDirectory)JetBrains.Annotations.dll" LogicalName="InjectionFiles.JetBrains.Annotations.dll"/>
    </ItemGroup>
</Project>
